<UserControl x:Class="MediFiler3.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="OnBrowsePreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SubtleScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="MinWidth" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{TemplateBinding Value}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" IsTabStop="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#3B3E45" MinHeight="8" SnapsToDevicePixels="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1" SnapsToDevicePixels="True" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" IsTabStop="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E7E8EA" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,5,4,5" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#111317" BorderBrush="#292B31" BorderThickness="1" CornerRadius="12" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Folders" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="8,6,8,12" />
                <TreeView x:Name="FolderTree" ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0" Foreground="#E7E8EA"
                          SelectedItemChanged="OnFolderSelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False" VirtualizingStackPanel.IsVirtualizing="False"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border HorizontalAlignment="Stretch" Padding="0,1" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#25282E" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Name}" Foreground="#E7E8EA" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItemStyle}" />
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SubtleScrollBarStyle}" />
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="#111317" BorderBrush="#292B31" BorderThickness="1" CornerRadius="12" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="4,2,4,14">
                    <TextBlock Text="{Binding ActiveFolder.Name, TargetNullValue=Files, FallbackValue=Files}" FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <TextBlock Text="{Binding ActiveFolder.Path}" FontSize="12" Foreground="#A3A6AE" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="210" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ImageViewport" Grid.Row="0" Background="#0B0C0E" Focusable="True"
                          SizeChanged="OnImageViewportSizeChanged" MouseDown="OnImageViewportMouseDown"
                          MouseUp="OnImageViewportMouseUp" MouseMove="OnImageViewportMouseMove"
                          MouseRightButtonDown="OnImageViewportRightButtonDown"
                          MouseWheel="OnImageViewportMouseWheel">
                        <Image x:Name="ImageViewer" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" />
                        <Border x:Name="ZoomInteractionBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                Padding="8,5" Background="#D916191E" CornerRadius="5" Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="ZoomInteractionText" Foreground="#E7E8EA" FontSize="11" />
                        </Border>
                        <Border x:Name="ThumbnailFallbackBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                Padding="8,5" Background="#D916191E" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock Text="Thumbnail preview • no integrated viewer" Foreground="#E7E8EA" FontSize="11" />
                        </Border>
                        <StackPanel x:Name="ImageMessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="24">
                            <TextBlock x:Name="ImageMessage" Text="Select an image from the file list." FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="ImageMessageDetail" Margin="0,8,0,0" Foreground="#A3A6AE" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <ListBox x:Name="CarouselList" SelectionChanged="OnCarouselSelectionChanged"
                                 Background="Transparent" BorderThickness="0" Foreground="#E7E8EA"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="164" Height="194" HorizontalAlignment="Center">
                                        <Border x:Name="ThumbnailBorder" Width="150" Height="150" Background="#0B0C0E"
                                                CornerRadius="6" Padding="0" ClipToBounds="True"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding PlaceholderText}" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="#777D88" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="150">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#292B31" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#75819A" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="#E7E8EA" FontSize="11" Margin="4,6,4,0"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="170" />
                                    <Setter Property="Height" Value="202" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="3" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1B1E24" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#252932" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyFilesNotice" Text="No files in this folder." Foreground="#A3A6AE"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
