<UserControl x:Class="MediFiler3.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MediFiler3.Views"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="OnBrowsePreviewKeyDown"
             PreviewMouseMove="OnBrowseSurfaceMouseMove"
             MouseLeave="OnBrowseSurfaceMouseLeave">
    <UserControl.Resources>
        <views:FolderTextBrushConverter x:Key="FolderTextBrush" />
        <views:TreeFooterMarginConverter x:Key="TreeFooterMargin" />
        <views:TreeGroupEndConverter x:Key="TreeGroupEnd" />
        <Style x:Key="SubtleScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="MinWidth" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" IsTabStop="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#3B3E45" MinHeight="8" SnapsToDevicePixels="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1" SnapsToDevicePixels="True" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" IsTabStop="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHiddenByRule}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="Foreground" Value="#E7E8EA" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin">
                <Setter.Value><MultiBinding Converter="{StaticResource TreeFooterMargin}">
                    <Binding /><Binding Path="TreeFooterRoot" RelativeSource="{RelativeSource AncestorType={x:Type views:BrowseView}}" />
                    <Binding Path="TreeScrollClearance" RelativeSource="{RelativeSource AncestorType={x:Type views:BrowseView}}" />
                </MultiBinding></Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="HeaderBackground" Grid.ColumnSpan="2" Background="Transparent" CornerRadius="3" />
                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0" Width="18" Height="26"
                                          PreviewMouseDown="OnFolderRowPreviewMouseDown"
                                          Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Foreground="#AEB4C0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock x:Name="ExpanderGlyph" Text="›" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" RenderTransformOrigin="0.6,0.6">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ExpanderGlyph" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />
                            <Border x:Name="SubfolderGap" Grid.Row="2" Height="14" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBackground" Property="Background" Value="#70454B57" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBackground" Property="Background" Value="#B04A5668" />
                            </Trigger>
                            <Trigger Property="views:BrowseView.IsGalleryDropTarget" Value="True">
                                <Setter TargetName="HeaderBackground" Property="Background" Value="#A0FF1493" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SubfolderGap" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <DataTrigger Binding="{Binding ActualHeight, ElementName=ItemsHost}" Value="0">
                                <Setter TargetName="SubfolderGap" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource TreeGroupEnd}">
                                        <Binding />
                                        <Binding Path="Parent.LastVisibleChild" />
                                        <Binding Path="TreeFooterRoot" RelativeSource="{RelativeSource AncestorType={x:Type views:BrowseView}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="SubfolderGap" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="BrowseSurface" Background="#000000" SizeChanged="OnBrowseSurfaceSizeChanged">
        <views:ViewerHostView x:Name="ViewerHost"
                              TextSideClearance="{Binding ActualWidth, ElementName=FolderOverlay}" />
        <Grid x:Name="GalleryHost" />
        <Grid x:Name="ReaderHost" Visibility="Collapsed" />


        <Border x:Name="FolderOverlay" Width="300" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Background="#E6000000" BorderBrush="#55464A52" BorderThickness="0,0,1,0" Padding="8"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FolderOverlayTransform" X="-300" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="8,2,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folders" FontSize="16" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <ToggleButton x:Name="FolderPinButton" Grid.Column="1" Width="38" Height="32"
                                  Padding="0" ToolTip="Pin folder panel open"
                                  AutomationProperties.Name="Pin folder panel open"
                                  Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                  Foreground="#BFC4CE" Click="OnFolderPinButtonClick">
                        <TextBlock x:Name="FolderPinGlyph" Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="PinBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PinBorder" Property="Background" Value="#202329" />
                                                    <Setter TargetName="PinBorder" Property="BorderBrush" Value="#50545E" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#BFC4CE" />
                                                    <Setter Property="BorderBrush" Value="#BFC4CE" />
                                                    <Setter Property="Foreground" Value="#202329" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Grid>
                <TreeView PreviewMouseWheel="OnGalleryTreeDragMouseWheel" AllowDrop="True" PreviewDragEnter="OnGalleryTreeDragOver" PreviewDragOver="OnGalleryTreeDragOver"
                          PreviewDragLeave="OnGalleryTreeDragLeave" PreviewDrop="OnGalleryTreeDrop" x:Name="FolderTree" Grid.Row="1" ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0"
                          Foreground="#E7E8EA" SelectedItemChanged="OnFolderSelectionChanged"
                          PreviewMouseRightButtonDown="OnFolderTreePreviewMouseRightButtonDown"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="1"
                          Padding="0,0,0,6"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid MinHeight="28" HorizontalAlignment="Stretch" PreviewMouseDown="OnFolderRowPreviewMouseDown"
                              PreviewMouseLeftButtonDown="OnFolderRowPreviewMouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" HorizontalAlignment="Stretch" Padding="4,5,8,5" CornerRadius="3">
                                <DockPanel>
                                    <views:FolderTreeIcon DockPanel.Dock="Left" FolderPath="{Binding Path}" Width="16" Height="16"
                                                          Margin="0,0,5,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource FolderTextBrush}">
                                                <Binding Path="Depth" />
                                                <Binding Path="FolderDepthShadingEnabled" RelativeSource="{RelativeSource AncestorType={x:Type views:BrowseView}}" />
                                                <Binding Path="RuleTextColor" />
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <Button Grid.Column="1" Width="24" Height="24" Padding="0" Margin="0,2,0,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Content="..."
                                    FontSize="14" FontWeight="Bold" Foreground="#BFC4CE" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1" Focusable="True"
                                    ToolTip="Folder actions" AutomationProperties.Name="Folder actions"
                                    Tag="{Binding}" PreviewMouseLeftButtonDown="OnFolderMenuButtonPreviewMouseDown"
                                    Click="OnFolderMenuButtonClick">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="MenuBorder" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MenuBorder" Property="Background" Value="#202329" />
                                                            <Setter TargetName="MenuBorder" Property="BorderBrush" Value="#50545E" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="MenuBorder" Property="Background" Value="#202329" />
                                                            <Setter TargetName="MenuBorder" Property="BorderBrush" Value="#778396" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItemStyle}" />
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SubtleScrollBarStyle}" />
                    </TreeView.Resources>
                </TreeView>
            </Grid>
        </Border>

        <Border x:Name="OperationNotice" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                Padding="12,8" Background="#E62B3039" BorderBrush="#657080" BorderThickness="1"
                CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="5">
            <TextBlock x:Name="OperationNoticeText" Foreground="#F5F5F5" FontSize="13" />
        </Border>

        <Border x:Name="CarouselOverlay" Height="175" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                BorderThickness="0" PreviewMouseWheel="OnCarouselPreviewMouseWheel" Opacity="0.65"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CarouselOverlayTransform" Y="153.125" />
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.8">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#7F000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <ListBox x:Name="CarouselList" SelectionChanged="OnCarouselSelectionChanged" RequestBringIntoView="OnCarouselRequestBringIntoView"
                         PreviewMouseLeftButtonDown="OnCarouselPreviewMouseLeftButtonDown"
                         Background="Transparent" BorderThickness="0" Foreground="#E7E8EA"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type views:CarouselSpacerItem}">
                            <Border Width="{Binding Width}" Height="1" Background="Transparent" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type views:CarouselThumbnailItem}">
                            <StackPanel Width="156" Height="170" HorizontalAlignment="Center">
                                <Grid Width="150" Height="150">
                                <Border x:Name="ThumbnailBorder" Width="150" Height="150" Background="#0B0C0E"
                                        Padding="0" ClipToBounds="True" HorizontalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding PlaceholderText}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#777D88" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Width="150" Height="150" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#292B31" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Grid IsHitTestVisible="False">
                                    <Border x:Name="CurrentThumbnailBorder" BorderBrush="#FFFF1493" BorderThickness="5" />
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                                </Grid>
                                <TextBlock Text="{Binding Name}" Foreground="#E7E8EA" FontSize="11" Margin="2,2,2,0"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Height="16" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="Loaded" Handler="OnCarouselItemLoaded" />
                            <Setter Property="Height" Value="174" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpacer}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Canvas x:Name="CarouselGhosts" IsHitTestVisible="False" ClipToBounds="True" />
                <TextBlock x:Name="EmptyFilesNotice" Text="No files in this folder." Foreground="#A3A6AE"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
