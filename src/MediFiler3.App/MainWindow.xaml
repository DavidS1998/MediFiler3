<Window x:Class="MediFiler3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:MediFiler3.Interop"
        Title="MediFiler3"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragEnter"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnMainWindowPreviewKeyDown"
        Background="#000000"
        Foreground="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#292B31" />
    </Window.Resources>

    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="56" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#000000" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 0 0 1">
            <interop:WinUiToolbarIsland x:Name="ToolbarIsland" Focusable="True" />
        </Border>

        <Border x:Name="Sidebar"
                Grid.Row="1"
                Grid.Column="0"
                Background="#000000"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <interop:WinUiNavigationIsland x:Name="NavigationIsland" Focusable="True" />
        </Border>

        <ContentControl x:Name="PageContent" Grid.Row="1" Grid.Column="1" />
    </Grid>
</Window>
